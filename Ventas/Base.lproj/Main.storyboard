                        <segue destination="nav-clients" kind="relationship" relationship="viewControllers" id="tab-link-clients"/>
                        <segue destination="nav-new-sale" kind="relationship" relationship="viewControllers" id="tab-link-newsale"/>
                        <segue destination="nav-sales" kind="relationship" relationship="viewControllers" id="tab-link-sales"/>
                        <segue destination="nav-dashboard" kind="relationship" relationship="viewControllers" id="tab-link-dashboard"/>
                        <segue destination="nav-account" kind="relationship" relationship="viewControllers" id="tab-link-account"/>
                    </connections>
                </tabBarController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="tabs-responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1200" y="-300"/>
        </scene>
