        <!--Main Tab Bar Controller-->
        <scene sceneID="scene-tabs">
            <objects>
                <tabBarController storyboardIdentifier="MainTabs" id="tabs-vc" customClass="MainTabBarController" customModule="Ventas" sceneMemberID="viewController">
                    <tabBar key="tabBar" contentMode="scaleToFill" id="main-tabbar">
                        <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
